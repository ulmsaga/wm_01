<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- %clr: Spring Boot 전용 ANSI 컬러 컨버터 명시 등록 -->
    <conversionRule conversionWord="clr"
                    converterClass="org.springframework.boot.logging.logback.ColorConverter"/>

    <!-- ===== Properties ===== -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="nttpoc"/>
    <property name="LOG_PATH"            value="${LOG_PATH:-./logs}"/>
    <property name="LOG_MAX_FILE_SIZE"   value="10MB"/>
    <property name="LOG_MAX_HISTORY"     value="30"/>
    <property name="LOG_TOTAL_CAP"       value="1GB"/>
    <property name="LOG_ERROR_TOTAL_CAP" value="500MB"/>

    <!-- ===== Patterns ===== -->
    <!-- Console: ANSI color -->
    <property name="PATTERN_CONSOLE"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%X{requestId:-NO_REQ}]){cyan} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){magenta} - %msg%n"/>
    <!-- File: plain text -->
    <property name="PATTERN_FILE"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%X{requestId:-NO_REQ}] [%15.15t] %-40.40logger{39} - %msg%n"/>

    <!-- ===== Appenders ===== -->

    <!-- Console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN_CONSOLE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Application log (rolling by date + size) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Error-only log -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_ERROR_TOTAL_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Async wrappers (I/O 블로킹 방지) -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ERROR_FILE"/>
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- ===== Profile: local ===== -->
    <springProfile name="local">

        <!-- 애플리케이션 패키지 -->
        <logger name="com.mobigen.aiop.nttpoc"                            level="DEBUG"/>

        <!-- MyBatis SQL 출력 (local 에서만) -->
        <logger name="org.apache.ibatis"                                  level="DEBUG"/>
        <logger name="org.mybatis.spring"                                 level="DEBUG"/>
        <logger name="org.mybatis.spring.mapper.ClassPathMapperScanner"   level="ERROR"/>

        <!-- Spring Security -->
        <logger name="org.springframework.security"                       level="DEBUG"/>

        <!-- DB Connection Pool -->
        <logger name="com.zaxxer.hikari"                                  level="INFO"/>

        <!-- p6spy: 파라미터 인라인 SQL 출력 -->
        <logger name="p6spy"                                              level="DEBUG"/>

        <!-- SSE 장기 연결 종료 시 Tomcat 내부 RecycleRequiredException 경고 억제 (노이즈, 실제 오류 아님) -->
        <logger name="org.apache.catalina.connector.CoyoteAdapter"       level="ERROR"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ===== Profile: prod ===== -->
    <springProfile name="prod">

        <!-- 애플리케이션 패키지 -->
        <logger name="com.mobigen.aiop.nttpoc"                            level="INFO"/>

        <!-- MyBatis: SQL 미출력 -->
        <logger name="org.mybatis.spring.mapper.ClassPathMapperScanner"   level="ERROR"/>

        <!-- Spring Security -->
        <logger name="org.springframework.security"                       level="WARN"/>

        <!-- DB Connection Pool -->
        <logger name="com.zaxxer.hikari"                                  level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

</configuration>
